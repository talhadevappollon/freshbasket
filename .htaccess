# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
# (Kept in the repo on purpose: every deploy resets this file, so a version picked in MultiPHP Manager would not stay.
#  The shop needs PHP 8.3 or newer.)
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

DirectoryIndex index.html index.php

# 1. Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
</IfModule>

# 2. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 2b. Browsers remember to use https for this site (they ignore this header on plain http)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# 3. Rewrite & Security Rules
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always https, and the bare domain instead of www. (cPanel's certificate checks under /.well-known stay on http.)
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Disable directory indexing
    Options -Indexes

    # Block direct access to sensitive files
    RewriteRule ^\.env$ - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^\.cpanel\.yml$ - [F,L,NC]
    RewriteRule ^backend/\.env$ - [F,L,NC]

    # Hidden launch on every live domain (freshhouse.pk, freshhouse.com.pk, ... share this folder); only the test site
    # and local testing are always open. See backend/app/Support/ShopPreview.php. Until the shop is opened in the
    # admin (Dashboard -> "Open the shop to everyone", which creates backend/storage/app/site-public), visitors get the
    # "Coming soon" page. Signed-in staff carry the fh_preview cookie; it counts only when its value names a key file
    # in backend/storage/app/preview on this server. The admin, the deploy webhook, certificate checks and static
    # files (scripts, styles, pictures, fonts) are never blocked.
    # TEMPORARY server checks for the hidden launch (each answers with the favicon when the feature works); removed next
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/.gitignore -f
    RewriteRule ^gate-test-1$ backend/public/favicon.ico [L]
    RewriteCond %{HTTP_COOKIE} (^|;\s*)fh_dbg=([a-z.]+)(;|$)
    RewriteRule ^gate-test-2$ backend/public/favicon.ico [L]
    RewriteCond %{HTTP_COOKIE} (^|;\s*)fh_dbg=([a-z.]+)(;|$)
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/%2 -f
    RewriteRule ^gate-test-3$ backend/public/favicon.ico [L]
    RewriteRule ^gate-test-4$ - [E=FH_DBG:1]
    RewriteCond %{ENV:FH_DBG} =1
    RewriteRule ^gate-test-4$ backend/public/favicon.ico [L]
    RewriteCond %{HTTP_COOKIE} fh_dbg=([a-z.]+)
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/%1 -f
    RewriteRule ^gate-test-5$ backend/public/favicon.ico [L]

    RewriteCond %{HTTP_COOKIE} (^|;\s*)fh_preview=([A-Za-z0-9]{40})(;|$)
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/preview/%2 -f
    RewriteRule ^ - [E=FH_PREVIEW:1]

    RewriteCond %{HTTP_HOST} !^(freshbasket\.aneetakomal\.com|localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/site-public !-f
    RewriteCond %{ENV:FH_PREVIEW} !=1
    RewriteCond %{REQUEST_URI} !^/(\.well-known/|_next/|admin(/|$)|cpanel_deploy\.php|robots\.txt)
    RewriteCond %{REQUEST_URI} !coming-soon\.html$
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|otf|map)$ [NC]
    RewriteRule ^ backend/public/coming-soon.html [L]

    # Rewrite all traffic into backend/public/
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>
