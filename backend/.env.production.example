# Fresh House — settings for a live cPanel server.
# Copy this file to backend/.env (cPanel File Manager: right-click → Copy), then fill in the blanks.
# Values with spaces or # in them go inside double quotes.

APP_NAME="Fresh House"
APP_ENV=production
# Left empty on purpose: the first deploy creates it. Never copy one from another server.
APP_KEY=
APP_DEBUG=false
# The site's address, with https:// and no slash at the end
APP_URL=https://CLIENT-DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel → MySQL Databases. cPanel puts the account name in front: e.g. clientuser_freshhouse
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Admin sign-in cookie only over https. Set false only while the site has no SSL certificate yet.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# In-store POS screen and API. Leave false until the POS is switched on (see config/features.php).
POS_ENABLED=false

# First staff account for /admin: created on the next deploy if it does not exist yet (never overwritten).
# Use a password of at least 10 characters. Delete the ADMIN_PASSWORD line after you have signed in once.
ADMIN_EMAIL=
ADMIN_NAME="Store Manager"
ADMIN_PASSWORD=""

# Password for the deploy webhook: a long random text (letters and digits). Put the same text in the
# GitHub webhook's "Secret" box. Manual deploy: https://CLIENT-DOMAIN/cpanel_deploy.php?secret=<this>
DEPLOY_SECRET=
