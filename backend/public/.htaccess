DirectoryIndex index.html index.php

# 1. Gzip & Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 2. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Pages must revalidate so a new deploy shows up immediately (hashed JS/CSS below stay long-lived)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images & Favicons
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 3. Cache-Control Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    Header unset ETag
    FileETag None
</IfModule>

# 4. Front Controller & Routing
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Hidden launch (see the top-level .htaccess): the top-level rules do not apply inside this folder, so someone
    # typing /backend/public/... directly gets the same "Coming soon". Normal traffic never has /backend/public in its address.
    RewriteCond %{HTTP_COOKIE} (^|;\s*)fh_preview=([A-Za-z0-9]{40})(;|$)
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/preview/%2 -f
    RewriteRule ^ - [E=FH_PREVIEW:1]
    RewriteCond %{THE_REQUEST} \s/+backend/public [NC]
    RewriteCond %{HTTP_HOST} !^(freshbasket\.aneetakomal\.com|localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/backend/storage/app/site-public !-f
    RewriteCond %{ENV:FH_PREVIEW} !=1
    RewriteCond %{REQUEST_URI} !(coming-soon\.html|cpanel_deploy\.php)$
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|otf|map)$ [NC]
    RewriteRule ^ coming-soon.html [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Clean URL support for pre-rendered Next.js pages (e.g. /cart -> /cart.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^\.]+)$ $1.html [NC,L]

    # Categories created after the last frontend build have no pre-rendered page: serve the generic
    # category shell (category/_.html), which reads the slug from the URL and loads the category by API.
    # Existing pages are matched by the rule above first.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^category/([^/\.]+)/?$ category/_.html [L]

    # Same for products added or renamed in the admin panel after the last build (products/_.html)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^products/([^/\.]+)/?$ products/_.html [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
